    "meta-block-text-line": {
      "_comment": "Fallback inside a ',,' block: free-form text, carrying the built-in relation 'text'.",
      "match": "^[ \\t]*([^\\r\\n]*[^ \\t\\r\\n])[ \\t]*$",
      "captures": {
        "1": {
