    },
    "meta-inline-separator": {
      "_comment": "';;' divides several (relation, object) assertions about one triple. Only meaningful inside the ',,' part.",
      "match": "(?<!;);;(?!;)",
      "name": "punctuation.separator.meta.ddot"
    },
    "meta-inline-text": {
      "_comment": [
        "Fallback: free-form inline meta text (MetaTextInline).",
        "The capture is whitespace-tight, matching `Meta := CM2 WS* MetaInline WS*` -- the WS",
        "after the ',,' is OUTSIDE MetaInline, and MetaTextInline may only begin with",
        "CM2/SC2/EM2/TX, never whitespace. Symmetric with #meta-block-text-line."
      ],
      "match": "[ \\t]*([^\\r\\n]*[^ \\t\\r\\n])[ \\t]*",
      "captures": {
        "1": {
          "name": "entity.name.object.meta.text.ddot",
          "patterns": [
            {
              "include": "#command"
            }
          ]
        }
      }
    },
    "command": {
      "_comment": "D6: all four spellings. Nested inside every field capture, so a field that IS a command scopes as one.",
      "match": "(?:(?<!!)!!(?!!)|(?:https?://)?ddot\\.it/)[^\\s?#]+(\\?[^\\s#]*)?(#\\S*)?",
      "name": "keyword.control.command.ddot",
      "captures": {
