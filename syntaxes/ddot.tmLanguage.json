              "include": "#meta-inline-separator"
            },
            {
              "include": "#meta-inline-text"
            }
          ]
        }
      }
    },
    "meta-inline-triple": {
      "_comment": "'..mr.. mo' inline after ',,'. MetaObjectInline := TextExcept{NL,SC2}, so it stops at ';;'.",
      "match": "[ \\t]*(?:((?<!\\.)(?:\\.{4}|\\.{2}[ \\t]+\\.{2})(?!\\.))|((?<!\\.)\\.{2}(?!\\.))[ \\t]*((?:(?!(?<!;);;(?!;))[^\\r\\n])*?)[ \\t]*((?<!\\.)\\.{2}(?!\\.)))[ \\t]*((?:(?!(?<!;);;(?!;))[^\\r\\n])*?)[ \\t]*(?=(?<!;);;(?!;)|$)",
      "captures": {
        "1": {
